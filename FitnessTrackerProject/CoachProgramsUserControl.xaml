<UserControl x:Class="FitnessTrackerProject.CoachProgramsUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red outline button (delete) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DC2626"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#FCA5A5" BorderThickness="1.5"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="960" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="48,0,0,16">
                <TextBlock Text="My programs" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="All the programs you created" FontSize="13" Foreground="#6B7280"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: list of programs -->
                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Your programs" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>

                        <ListBox x:Name="lstPrograms" BorderThickness="0" Background="Transparent"
                                 MaxHeight="520" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 HorizontalContentAlignment="Stretch"
                                 SelectionChanged="Programs_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Background="White" BorderBrush="#E5E7EB"
                                                        BorderThickness="1.5" CornerRadius="10" Padding="14,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3B82F6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#3B82F6" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Created}" FontSize="11" Foreground="#9CA3AF"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Shown only when there are no programs -->
                        <StackPanel x:Name="panelEmpty" Visibility="Collapsed" Margin="0,12">
                            <TextBlock Text="No programs yet." FontSize="13" Foreground="#6B7280"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Button Content="Create your first program" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Center" Click="CreateButton_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: details of the selected program -->
                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock x:Name="txtNoSelection" Text="Select a program to see its days and exercises."
                                   FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,24"/>

                        <StackPanel x:Name="panelDetails" Visibility="Collapsed">
                            <Grid Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="txtProgramName" FontSize="18" FontWeight="SemiBold" Foreground="#111827"/>
                                    <TextBlock x:Name="txtProgramInfo" FontSize="13" Foreground="#6B7280"/>
                                </StackPanel>
                                <Button Content="Delete program" Style="{StaticResource DangerButton}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="DeleteProgram_Click"/>
                            </Grid>

                            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="lstDays">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Header}" FontSize="14" FontWeight="SemiBold"
                                                               Foreground="#111827" Margin="0,0,0,6"/>
                                                    <ItemsControl ItemsSource="{Binding Lines}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,2">
                                                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#374151"/>
                                                                    <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="#6B7280"
                                                                               HorizontalAlignment="Right"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>