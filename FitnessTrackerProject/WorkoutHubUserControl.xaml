<UserControl x:Class="FitnessTrackerProject.WorkoutHubUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:FitnessTrackerProject"
             mc:Ignorable="d"
             d:DesignHeight="650" d:DesignWidth="800" Background="#F3F4F6">

    <UserControl.Resources>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- Main blue button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Outline button (secondary action, e.g. "Live camera") -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#3B82F6"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="26,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small text-only button ("All exercises") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="760" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (left margin leaves room for the menu button) -->
            <StackPanel Grid.Row="0" Margin="48,0,0,16">
                <TextBlock Text="WorkoutHub" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Pick an exercise, add a video, get your count" FontSize="13" Foreground="#6B7280"/>
            </StackPanel>

            <!-- Two columns -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->
                <StackPanel Grid.Column="0">

                    <!-- 1. Choose exercise (two exercises + link to all exercises) -->
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="1. Choose exercise" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                                <Button Content="All exercises  &#x203A;" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Right" Click="AllExercises_Click"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="cardA" Grid.Column="0" Margin="0,0,5,0"
            CornerRadius="12" BorderThickness="1.5" Padding="14" Cursor="Hand"
            MouseLeftButtonUp="ExerciseCard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="iconA" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="nameA" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock x:Name="subA" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="cardB" Grid.Column="1" Margin="5,0,0,0"
            CornerRadius="12" BorderThickness="1.5" Padding="14" Cursor="Hand"
            MouseLeftButtonUp="ExerciseCard_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="iconB" FontFamily="Segoe MDL2 Assets" FontSize="22"
                       Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="nameB" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                            <TextBlock x:Name="subB" FontSize="12" Foreground="#6B7280"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 2. Add your video -->
                    <Border Background="White" CornerRadius="12" Padding="16">
                        <StackPanel>
                            
                            <TextBlock Text="2. Add your video" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                            <TextBlock x:Name="txtHint" FontSize="12" Foreground="#6B7280"
                                               HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Select video" Style="{StaticResource PrimaryButton}" Click="SelectVideoButton_Click"/>

                                    <Button Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="LiveCameraButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Live camera" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- RIGHT -->
                <StackPanel Grid.Column="2">

                    <!-- Latest result (empty for now, ready to be connected later) -->
                    <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Latest result" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="txtBigNumber" Text="--" FontSize="40" FontWeight="SemiBold" Foreground="#111827"/>
                                <TextBlock x:Name="txtUnit" Text="no workout yet" FontSize="14" Foreground="#6B7280"
                                           VerticalAlignment="Bottom" Margin="8,0,0,9"/>
                            </StackPanel>

                            <Border x:Name="noteBadge" CornerRadius="8" Padding="10,3" Margin="0,8,0,0"
                                    HorizontalAlignment="Left" Visibility="Collapsed">
                                <TextBlock x:Name="txtNote" FontSize="12" FontWeight="SemiBold"/>
                            </Border>

                            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,12,0,0">
                                <Grid>
                                    <TextBlock Text="Tracking quality" FontSize="13" Foreground="#6B7280"/>
                                    <TextBlock x:Name="txtQuality" Text="--" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#111827" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Tip -->
                    <Border Background="#EFF6FF" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="#1D4ED8" Margin="0,1,10,0" VerticalAlignment="Top"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="13" Foreground="#1E3A8A"
                                       Text="Film from the side, with your feet in the shot, for the best count."/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Recent workouts (empty for now) -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Recent workouts" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtNoHistory" Text="No workouts yet. Pick an exercise and add a video."
                               FontSize="13" Foreground="#6B7280" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>