<Window x:Class="FitnessTrackerProject.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessTrackerProject"
        mc:Ignorable="d"
        Title="LoginWindow" Height="450" Width="800">
    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="250">
            <TextBlock Text="Welcome Back!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Username:" FontWeight="SemiBold"/>
            <TextBox x:Name="LoginUsernameBox" Height="25" Margin="0,0,0,15" Padding="2"/>

            <TextBlock Text="Password:" FontWeight="SemiBold"/>
            <PasswordBox x:Name="LoginPasswordBox" Height="25" Margin="0,0,0,20" Padding="2"/>

            <Button Content="Log In" Click="LoginButton_Click" Height="30" FontWeight="Bold" Background="LightGreen" Margin="0,0,0,10"/>

            <Button Content="Don't have an account? Sign Up" Click="GoToSignUp_Click" Background="Transparent" BorderBrush="Transparent" Foreground="Blue" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
