<Window x:Class="FitnessTrackerProject.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FitnessTrackerProject"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

            <TextBlock Text="MediaPipe ONNX Fitness Tracker" 
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- The Plank Mode Checkbox -->
            <CheckBox x:Name="PlankModeCheckBox" 
                      Content="Horizontal Exercise Mode (Planks/Pushups)" 
                      FontSize="14" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- The Video Selection Button -->
            <Button Content="Select Video" Width="150" Height="40" 
                    FontSize="14" Click="SelectVideoButton_Click"/>

        </StackPanel>
    </Grid>     
</Window>
