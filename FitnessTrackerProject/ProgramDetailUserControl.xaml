<UserControl x:Class="FitnessTrackerProject.ProgramDetailUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">
    <UserControl.Resources>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- Small blue "Start" button -->
        <Style x:Key="StartButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text-only button ("Back") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One exercise of a day -->
        <DataTemplate x:Key="ExerciseRow">
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="12,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="{Binding Details}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Start" Tag="{Binding Name}"
                            Click="StartExercise_Click" Style="{StaticResource StartButton}"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One day -->
        <DataTemplate x:Key="DayCard">
            <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <Button Content="Start Day" Style="{StaticResource StartButton}"
                        HorizontalAlignment="Right" Click="StartDay_Click" Tag="{Binding}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Exercises}" ItemTemplate="{StaticResource ExerciseRow}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="760">
            <StackPanel>

                <!-- Back (left margin leaves room for the menu button) -->
                <Button Content="&#x2039;  Back to WorkoutHub" Style="{StaticResource LinkButton}"
                        Click="Back_Click" HorizontalAlignment="Left" Margin="48,0,0,14"/>

                <!-- Program header with the trainer's picture -->
                <Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Top">
                            <Ellipse Fill="#DBEAFE"/>
                            <TextBlock x:Name="txtInitial" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Ellipse>
                                <Ellipse.Fill>
                                    <ImageBrush x:Name="picBrush" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="txtName" FontSize="20" FontWeight="SemiBold" Foreground="#111827"/>
                            <TextBlock x:Name="txtSubtitle" FontSize="13" Foreground="#3B82F6" Margin="0,2,0,0"/>
                            <TextBlock x:Name="txtCoach" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Days -->
                <ItemsControl x:Name="lstDays" ItemTemplate="{StaticResource DayCard}"/>
                <TextBlock x:Name="txtNoDays" Text="This program has no days yet."
                           FontSize="13" Foreground="#6B7280" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>