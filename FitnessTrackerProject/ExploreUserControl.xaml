<UserControl x:Class="FitnessTrackerProject.ExploreUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6">

    <UserControl.Resources>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
        </Style>

        <!-- Blue "Choose" button. It turns green when it is already chosen. -->
        <Style x:Key="ChooseButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small text-only button ("Remove") -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One trainer -->
        <DataTemplate x:Key="TrainerCard">
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile picture (the first letter shows if there is no picture) -->
                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="#DBEAFE"/>
                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="{Binding Specialty}" FontSize="12" Foreground="#3B82F6" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Bio}" FontSize="12" Foreground="#6B7280"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding Id}"
                            Click="ChooseTrainer_Click"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChooseButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#16A34A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One program (with the picture of its trainer) -->
        <DataTemplate x:Key="ProgramCard">
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1"
                    CornerRadius="10" Padding="12" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Top">
                        <Ellipse Fill="#DBEAFE"/>
                        <TextBlock Text="{Binding Initial}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding Picture}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="#3B82F6" Margin="0,2,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="by " FontSize="12" Foreground="#6B7280"/>
                            <TextBlock Text="{Binding CoachName}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#374151"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Stats}" FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding Id}"
                            Click="ChooseProgram_Click"
                            VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ChooseButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#6B7280"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,16,24,24" MaxWidth="760">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (left margin leaves room for the menu button) -->
            <StackPanel Grid.Row="0" Margin="48,0,0,16">
                <TextBlock Text="Explore" FontSize="22" FontWeight="SemiBold" Foreground="#111827"/>
                <TextBlock Text="Choose a program or a dedicated trainer" FontSize="13" Foreground="#6B7280"/>
            </StackPanel>

            <!-- Your choices + tip -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Your choices" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtCurrentTrainer" FontSize="14" Foreground="#111827"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="btnClearTrainer" Grid.Column="1" Content="Remove"
                                Style="{StaticResource LinkButton}" Foreground="#DC2626"
                                Click="ClearTrainer_Click" Visibility="Collapsed"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtCurrentProgram" FontSize="14" Foreground="#111827"/>
                    </Grid>

                    <Border Background="#EFF6FF" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="#1E3A8A"
                                   Text="You can choose a program, a trainer, or both."/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Programs -->
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Programs" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="lstPrograms" ItemTemplate="{StaticResource ProgramCard}"/>
                    <TextBlock x:Name="txtNoPrograms" Text="No programs have been created yet."
                               FontSize="13" Foreground="#6B7280" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- Trainers -->
            <Border Grid.Row="3" Background="White" CornerRadius="12" Padding="16">
                <StackPanel>
                    <TextBlock Text="Trainers" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="lstTrainers" ItemTemplate="{StaticResource TrainerCard}"/>
                    <TextBlock x:Name="txtNoTrainers" Text="There are no trainers yet."
                               FontSize="13" Foreground="#6B7280" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>